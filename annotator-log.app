class com.netflix.conductor.core.execution.mapper.HumanTaskMapper {
@Override
  public List<TaskModel> getMappedTasks(TaskMapperContext taskMapperContext) {

    WorkflowModel workflowModel = taskMapperContext.getWorkflowModel();
