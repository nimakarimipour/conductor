    }

    List<TaskModel> joinTask =
        taskMapperContext
            .getDeciderService()
            .getTasksToBeScheduled(workflowModel, joinWorkflowTask, retryCount);

    tasksToBeScheduled.addAll(joinTask);
    return tasksToBeScheduled;
  }
