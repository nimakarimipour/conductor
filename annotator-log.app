        getExternalOutputPayloadStoragePath(),
        getPriority(),
        getVariables(),
        getLastRetriedTime(),
        getOwnerApp(),
        getCreateTime(),
        getUpdatedTime(),
        getCreatedBy(),
        getUpdatedBy());
}
