        if (workflow.getStatus().isTerminal()) {
            // you cannot evaluate a terminal workflow
            LOGGER.debug(
                    "Workflow {} is already finished. Reason: {}",
                    workflow,
                    workflow.getReasonForIncompletion());
            return outcome;
        }

