                                    ? workflowModel.getWorkflowDefinition().getTimeoutSeconds() + 1
                                    : workflowOffsetTimeout;
                }
                break;
            }
        }
        queueDAO.setUnackTimeout(
                DECIDER_QUEUE, workflowModel.getWorkflowId(), postponeDurationSeconds * 1000);
